-- ========================================================
-- DATABASE: groceryshop (or restaurant)
-- Ensure database name matches config.php ($connection)
-- ========================================================

CREATE DATABASE IF NOT EXISTS `groceryshop` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE `groceryshop`;

-- ========================================================
-- 1. USERS TABLE (`uesr`)
-- Stores registered customers and admin accounts
-- ========================================================
CREATE TABLE IF NOT EXISTS `uesr` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `name` VARCHAR(100) NOT NULL,
    `email` VARCHAR(100) UNIQUE NOT NULL,
    `password` VARCHAR(255) NULL,
    `phone` VARCHAR(25) NULL,
    `address` TEXT NULL,
    `role` ENUM('user', 'admin') DEFAULT 'user',
    `is_verified` TINYINT(1) DEFAULT 0,
    `verify_token` VARCHAR(255) NULL,
    `otp` VARCHAR(10) NULL,
    `reset_expires` DATETIME NULL,
    `google_id` VARCHAR(100) NULL,
    `profile_picture` VARCHAR(255) NULL,
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- ========================================================
-- 2. CATEGORIES TABLE (`category`)
-- Stores food categories (Biryani, BBQ, Karahi, etc.)
-- ========================================================
CREATE TABLE IF NOT EXISTS `category` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `category_name` VARCHAR(100) NOT NULL,
    `category_details` TEXT NULL,
    `category_image` VARCHAR(255) NULL,
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- ========================================================
-- 3. PRODUCTS TABLE (`product`)
-- Stores menu items/dishes
-- ========================================================
CREATE TABLE IF NOT EXISTS `product` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `category_id` INT NULL,
    `product_name` VARCHAR(100) NOT NULL,
    `product_details` TEXT NULL,
    `product_price` INT NOT NULL,
    `product_image` VARCHAR(255) NULL,
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (`category_id`)
        REFERENCES `category`(`id`)
        ON DELETE SET NULL
        ON UPDATE CASCADE
) ENGINE=InnoDB;

-- ========================================================
-- 4. CART TABLE (`card`)
-- Stores active shopping cart items per user
-- ========================================================
CREATE TABLE IF NOT EXISTS `card` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `user_id` INT NOT NULL,
    `product_id` INT NOT NULL,
    `quantity` INT NOT NULL DEFAULT 1,
    `price` INT NOT NULL,
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (`user_id`)
        REFERENCES `uesr`(`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    FOREIGN KEY (`product_id`)
        REFERENCES `product`(`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE
) ENGINE=InnoDB;

-- ========================================================
-- 5. ORDERS TABLE (`orders`)
-- Stores confirmed orders and customer delivery info
-- ========================================================
CREATE TABLE IF NOT EXISTS `orders` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `user_id` INT NOT NULL,
    `customer_name` VARCHAR(100) NOT NULL,
    `customer_phone` VARCHAR(25) NOT NULL,
    `customer_address` TEXT NOT NULL,
    `payment_method` VARCHAR(50) DEFAULT 'Cash On Delivery',
    `total_amount` INT NOT NULL,
    `order_status` VARCHAR(50) DEFAULT 'pending',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (`user_id`)
        REFERENCES `uesr`(`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE
) ENGINE=InnoDB;

-- ========================================================
-- 6. ORDER ITEMS TABLE (`order_items`)
-- Stores individual items belonging to an order
-- ========================================================
CREATE TABLE IF NOT EXISTS `order_items` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `order_id` INT NOT NULL,
    `product_id` INT NOT NULL,
    `quantity` INT NOT NULL DEFAULT 1,
    `price` INT NOT NULL,
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (`order_id`)
        REFERENCES `orders`(`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    FOREIGN KEY (`product_id`)
        REFERENCES `product`(`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE
) ENGINE=InnoDB;